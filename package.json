{
  "name": "dnd-anywhere-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Drag and drop files onto any file upload control on any website.",
  "license": "MIT",
  "author": "Rojan Acharya <hello@rojanacharya.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjach/dnd-anywhere.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter extension dev",
    "build": "pnpm --filter extension build",
    "zip": "pnpm --filter extension zip",
    "test": "pnpm --filter extension test",
    "e2e": "pnpm --filter extension e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "check:network": "node scripts/check-no-network.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm build && pnpm check:network && pnpm check:manifest && pnpm check:size && pnpm check:licenses",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  },
  "type": "module"
}
