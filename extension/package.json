{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "description": "DnD Anywhere browser extension",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "zip": "wxt zip && wxt zip -b edge && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "wxt build && playwright test",
    "e2e:headed": "wxt build && playwright test --headed",
    "store:assets": "wxt build && node scripts/generate-store-assets.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "wxt": "^0.21.4"
  }
}
